# Local paper settings. Copy to .env to persist these settings.
MARKET_EXCHANGE=binance
MARKET_SYMBOLS=BTC/USDT
MARKET_POLL_SECONDS=60
MARKET_MAX_AGE_SECONDS=180
MARKET_FEED_ENABLED=false
OMNI_QUANT_DB_PATH=./data/omni_quant.sqlite3
OMNI_QUANT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional. true blocks new longs and persists the switch; false clears it.
# PAPER_KILL_SWITCH=true
LIVE_TRADING_ENABLED=false
