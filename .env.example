# Copy to .env; never commit the copy.
# Relative paths are resolved from the repository root.
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

MARKET_EXCHANGE=binance
MARKET_SYMBOLS=BTC/USDT
MARKET_POLL_SECONDS=60
# Keep false for API/dashboard-only startup; set true only when public OHLCV feed is needed.
MARKET_FEED_ENABLED=false
SNAPSHOT_INTERVAL_SECONDS=2

OMNI_QUANT_DB_PATH=data/omni_quant.sqlite3
OMNI_QUANT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Live execution is not implemented by the current core.
LIVE_TRADING_ENABLED=false

# Optional advisory LLM configuration belongs in a local .env only.
# GEMINI_KEYS=
